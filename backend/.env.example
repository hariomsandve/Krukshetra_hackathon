# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=adaptive_learning

# Firebase Admin Authentication
# Optional path to serviceAccountKey.json; if omitted, Google Application Default Credentials will be used
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Application Configuration
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=0.0.0.0

# Gemini Multimodal Live API Configuration
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_VOICE_MODEL=gemini-2.0-flash-exp
GEMINI_VOICE_NAME=Puck

